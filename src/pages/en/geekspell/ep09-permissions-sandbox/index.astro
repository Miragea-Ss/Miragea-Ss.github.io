---
import Layout from '../../../../site-layouts/Layout.astro';
import GeekSpellBaseStyles from '../../../../components/geekspell/GeekSpellBaseStyles.astro';

const YT_ID = 'yQW4TAupqcM';
const YT_EMBED = `https://www.youtube.com/embed/${YT_ID}`;
const YT_WATCH = `https://youtu.be/${YT_ID}`;
const BILI = 'https://www.bilibili.com/video/BV1gh3P6ZErW/';
const YT_JA = 'https://youtu.be/tlN_uW7Duls';
---

<Layout title="EP09 · Permissions & Sandbox | GeekSpell" lang="en">
  <GeekSpellBaseStyles />
  <main class="gs-ep-page">
    <div class="gs-wrap">
      <p class="gs-crumb">
        <a href="/en/">Archive</a> · <a href="/en/geekspell/">GeekSpell</a> · EP09
      </p>
      <p class="gs-eyebrow">GeekSpell literacy EP09 · English · Permissions &amp; Sandbox</p>
      <h1>Permissions &amp; sandbox: before an agent touches files</h1>
      <p class="gs-lead">
        Write the boundary before you hand over a path. An agent without a boundary is an intern with
        root access.
      </p>
      <div class="gs-player">
        <iframe
          src={YT_EMBED}
          title="GeekSpell EP09 EN"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        />
      </div>
      <p class="gs-links">
        <a href="/en/geekspell/ep08-brief-delivery/">← EP08 One-page loop</a>
        ·
        <a href="/zh/geekspell/ep09-permissions-sandbox/">中文 EP09</a>
        ·
        <a href="/ja/geekspell/ep09-permissions-sandbox/">日本語 EP09</a>
        ·
        <a href={YT_WATCH} target="_blank" rel="noopener">YouTube</a>
        ·
        <a href={BILI} target="_blank" rel="noopener">Bilibili ZH</a>
        ·
        <a href={YT_JA} target="_blank" rel="noopener">YouTube JA</a>
      </p>
      <section class="gs-body">
        <h2>What you will learn</h2>
        <ul>
          <li>Anti-pattern: “handle this folder” with no allow-list, backup, or dry-run</li>
          <li>Principle: boundary before path</li>
          <li>Three colors: green read-only · yellow sandbox write · red deny by default</li>
          <li>Permission card: five fields filled before work starts</li>
          <li>Copy to sandbox first · dry-run · green / yellow / red · you accept</li>
        </ul>
        <h2>Series path</h2>
        <p>
          EP08 one-page loop → <strong>EP09 permissions &amp; sandbox</strong> → EP10 budget &amp;
          cost.
        </p>
      </section>
    </div>
  </main>
</Layout>
