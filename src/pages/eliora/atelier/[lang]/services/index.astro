---
import AtelierLayout from '../../../../../site-layouts/AtelierLayout.astro';
import AtelierServices from '../../../../../components/atelier/AtelierServices.astro';
import type { AtelierLang } from '../../../../../data/atelier-copy';
import { servicesPageCopy } from '../../../../../data/services-page-copy';

// Services page is Japanese-only for now (en / zh are intentionally not generated).
export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }];
}

const lang = 'ja' as AtelierLang;
const copy = servicesPageCopy.ja;
---

<AtelierLayout title={copy.meta.title} description={copy.meta.description} lang={lang}>
  <AtelierServices lang={lang} copy={copy} />
</AtelierLayout>
