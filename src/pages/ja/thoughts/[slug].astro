---
import { getCollection, render } from 'astro:content';
import Layout from '../../../site-layouts/Layout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('thoughts');
  return entries
    .filter((entry) => !entry.id.includes('/'))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasEnglishOnlyMedia = /<(?:audio|video)\b/i.test(entry.body);
const englishOriginalHref = `/en/thoughts/${entry.id}/`;
---

<Layout
  title={entry.data.title}
  lang="ja"
  description={`${entry.data.title} — Mirageaアーカイブ。音声作品は公開言語に合わせて案内します。`}
>
  <main class="min-h-screen bg-black px-6 py-24 text-gray-200">
    <article class="mx-auto max-w-3xl">
      {entry.data.cover && (
        <img src={entry.data.cover} alt={entry.data.title} class="mb-10 h-80 w-full rounded-2xl object-cover" />
      )}
      <h1 class="mb-4 text-4xl font-bold md:text-5xl">{entry.data.title}</h1>
      <div class="mb-10 flex flex-wrap gap-3 font-mono text-sm text-gray-500">
        <span>{entry.data.intuitionDate.toISOString().split('T')[0]}</span>
        <span>CONFIDENCE: {entry.data.confidence}%</span>
      </div>
      {hasEnglishOnlyMedia ? (
        <section class="rounded-2xl border border-amber-300/20 bg-amber-300/[0.04] p-6 text-gray-300">
          <p class="font-mono text-xs tracking-[0.18em] text-amber-200">ORIGINAL AUDIO · ENGLISH</p>
          <h2 class="mt-3 text-2xl font-semibold text-white">この作品の音声は英語原版です</h2>
          <p class="mt-4 leading-8">
            日本語ページで異なる言語の音声を自動再生しないため、ここでは音声と映像を表示していません。
            英語原版の作品ページで視聴できます。
          </p>
          <a href={englishOriginalHref} class="mt-6 inline-flex rounded-full border border-white/20 px-5 py-3 font-semibold text-white transition hover:border-white/45 hover:bg-white/[0.06]">
            英語原版を開く →
          </a>
        </section>
      ) : (
        <div class="space-y-6 leading-8 text-gray-300">
          <Content />
        </div>
      )}
      <a href="/ja/" class="mt-14 inline-flex text-gray-400 transition hover:text-white">アーカイブへ戻る</a>
    </article>
  </main>
</Layout>
