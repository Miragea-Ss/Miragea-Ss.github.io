---
// A single quiet line at the end of Miragea-side articles (GeekSpell episodes, thoughts).
// Miragea is the artistic space: no prices and no sales copy here. Business starts at Eliora.
import { workCtaCopy, type CtaLang, type CtaVariant } from '../data/work-cta-copy';

interface Props {
  lang: CtaLang;
  variant?: CtaVariant;
}

const { lang } = Astro.props;
const copy = workCtaCopy[lang];
const href = `/eliora/index.html?lang=${lang}`;
---

<p class="wc-quiet"><a href={href}>{copy.line} <span aria-hidden="true">→</span></a></p>

<style>
  .wc-quiet { margin: 56px 0 8px; font-size: 0.85rem; line-height: 1.8; }
  .wc-quiet a { color: rgba(200, 208, 224, 0.62); text-decoration: none; border-bottom: 1px solid rgba(201, 169, 98, 0.35); padding-bottom: 2px; transition: color 0.3s, border-color 0.3s; }
  .wc-quiet a:hover { color: #e8ecf4; border-color: rgba(201, 169, 98, 0.8); }
</style>
