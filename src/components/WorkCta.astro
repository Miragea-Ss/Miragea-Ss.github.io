---
import { workCtaCopy, type CtaLang, type CtaVariant } from '../data/work-cta-copy';

interface Props {
  lang: CtaLang;
  variant?: CtaVariant;
}

const { lang, variant = 'episode' } = Astro.props;
const copy = workCtaCopy[variant][lang];
const services = `/eliora/atelier/${lang}/services/`;
const contact = `/eliora/atelier/${lang}/contact/`;
---

<aside class="wc" aria-label={copy.eyebrow} data-variant={variant}>
  <p class="wc-eyebrow">{copy.eyebrow}</p>
  <h2 class="wc-title">{copy.title}</h2>
  <p class="wc-body">{copy.body}</p>
  <div class="wc-actions">
    <a class="wc-btn wc-btn--primary" href={services}>{copy.primary}</a>
    <a class="wc-btn wc-btn--secondary" href={contact}>{copy.secondary}</a>
  </div>
</aside>

<style>
  .wc {
    margin: 48px 0 8px;
    padding: 24px 26px 22px;
    border: 1px solid rgba(201, 169, 98, 0.28);
    border-radius: 14px;
    background: linear-gradient(160deg, rgba(26, 26, 62, 0.5), rgba(10, 10, 15, 0.6));
    color: #c8d0e0;
  }
  .wc[data-variant='soft'] { margin-top: 56px; background: rgba(26, 26, 62, 0.3); border-color: rgba(200, 208, 224, 0.16); }
  .wc-eyebrow { margin: 0 0 6px; font: 500 0.68rem "IBM Plex Mono", ui-monospace, monospace; letter-spacing: 0.2em; text-transform: uppercase; color: #c9a962; }
  .wc-title { margin: 0 0 10px; font-size: 1.2rem; line-height: 1.4; font-weight: 600; color: #e8ecf4; }
  .wc-body { margin: 0 0 18px; font-size: 0.92rem; line-height: 1.85; color: #c8d0e0; max-width: 62ch; }
  .wc-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .wc-btn { display: inline-flex; align-items: center; min-height: 42px; padding: 0 18px; border-radius: 10px; font-size: 0.88rem; font-weight: 600; text-decoration: none; transition: border-color 0.3s, transform 0.3s; }
  .wc-btn--primary { background: linear-gradient(90deg, #c9a962, #a88b4a); color: #0a0a0f; }
  .wc-btn--secondary { border: 1px solid rgba(200, 208, 224, 0.32); color: #e8ecf4; }
  .wc-btn:hover { transform: translateY(-1px); }
  .wc-btn--secondary:hover { border-color: rgba(201, 169, 98, 0.7); }
</style>
