---
// Scope, deliverables, revisions, delivery period and fee of Discovery "Automation Sprint" (仕組みの制作).
// Plain text nodes only: each one is translated by data/discovery-locales.mjs.
---
<dl class="sprint-scope" aria-label="AUTOMATION SPRINT">
  <div><dt>SCOPE</dt><dd>One agreed workflow with one starting point and one result, connecting up to two agreed tools or data sources.</dd></div>
  <div><dt>DELIVERABLES</dt><dd>The working workflow with its settings, a one-page operating guide, and a test record against up to five agreed examples.</dd></div>
  <div><dt>REVISIONS</dt><dd>One revision round after delivery, within the agreed scope.</dd></div>
  <div><dt>DELIVERY PERIOD</dt><dd>Within 14 days after you approve the scope.</dd></div>
  <div><dt>NOT INCLUDED</dt><dd>Local AI setup with an accuracy report, more than one workflow, and ongoing support. Local AI builds are offered in Atelier; monthly support is separate.</dd></div>
  <div><dt>FEE</dt><dd>¥60,000 (excl. tax; ¥66,000 incl. tax)</dd></div>
</dl>
<style>
  .sprint-scope{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 48px;margin:28px 0;padding:0}
  .sprint-scope>div{border-top:1px solid var(--glass-border);padding:14px 0 18px}
  .sprint-scope dt{font:400 13px/1.6 var(--font-instrument);letter-spacing:.08em;color:var(--moonlight)}
  .sprint-scope dd{margin:6px 0 0;font:15px/1.8 var(--font-explanation);color:var(--eliora-muted)}
  :global(.scan-deliverables) .sprint-scope{grid-template-columns:1fr;margin:18px 0 0}
  :global(.scan-deliverables) .sprint-scope dd{font-size:13px;line-height:1.7}
  @media (max-width:720px){.sprint-scope{grid-template-columns:1fr}}
</style>
