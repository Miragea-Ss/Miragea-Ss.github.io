---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'thoughts'>;
  lang?: 'en' | 'ja' | 'zh';
  class?: string;
}

const { post, lang = 'ja', class: className = '' } = Astro.props;
const thoughtHref = post.id.includes('/')
  ? `/thoughts/${post.id}/`
  : `/${lang}/thoughts/${post.id}/`;

const topicText = post.data.topics.join(' ');
const isRose = /Creator|Dreamer/.test(topicText) || (!/Builder|Observer/.test(topicText) && post.data.confidence > 80);
const glowColor = isRose ? 'shadow-rose-900/50' : 'shadow-cyan-900/40';
const borderColor = isRose ? 'border-rose-400/40' : 'border-cyan-400/35';
const tagColor = isRose ? 'border-rose-400/35 text-rose-100/80' : 'border-cyan-400/35 text-cyan-100/80';
const glow = isRose
  ? 'radial-gradient(circle, rgba(244,63,94,.62) 0%, rgba(244,63,94,.22) 36%, transparent 70%)'
  : 'radial-gradient(circle, rgba(34,211,238,.55) 0%, rgba(34,211,238,.18) 38%, transparent 72%)';
---

<a href={thoughtHref} class={`block group ${className}`}>
  <article
    class={`relative p-8 rounded-2xl border backdrop-blur-sm bg-black/50 transition-all duration-700 group-hover:scale-[1.02] shadow-2xl ${glowColor} ${borderColor}`}
  >
    <div class="pointer-events-none absolute right-0 top-0 h-36 w-36" aria-hidden="true">
      <div class="absolute -right-6 -top-6 h-32 w-32 rounded-full" style={`background:${glow}`}></div>
      <div class="absolute right-6 top-6 h-3.5 w-3.5 rounded-full bg-black"></div>
    </div>

    {post.data.cover && (
      <img
        src={post.data.cover}
        alt={post.data.title}
        class="mb-6 h-48 w-full rounded-lg object-cover opacity-80 transition duration-500 group-hover:opacity-100"
      />
    )}

    <div class="mb-4 font-mono text-xs tracking-widest text-gray-600">
      {post.data.intuitionDate.toISOString().split('T')[0]}
    </div>

    <h2 class="mb-4 text-2xl font-bold leading-tight text-gray-100 transition group-hover:text-white md:text-3xl">
      {post.data.title}
    </h2>

    <p class="mb-6 border-l-2 border-gray-700 pl-4 text-sm italic text-gray-400">
      "{post.data.atmosphere}"
    </p>

    <div class="mt-4 flex flex-wrap gap-2">
      {post.data.topics.map((tag) => (
        <span class={`rounded border bg-black/40 px-2 py-1 text-xs ${tagColor}`}>#{tag}</span>
      ))}
    </div>
  </article>
</a>
