---
import { bizStripCopy, type BizLang } from '../data/biz-strip-copy';

interface Props {
  lang: BizLang;
  /** 'atelier' sits on the Atelier home (serif heading); 'archive' sits on the Miragea home. */
  tone?: 'atelier' | 'archive';
}

const { lang, tone = 'atelier' } = Astro.props;
const copy = bizStripCopy[lang];
---

<section class={`bz-wrap bz-${tone}`} aria-labelledby={`bz-title-${tone}`}>
  <div class="bz" data-lang={lang}>
    <p class="bz-eyebrow">{copy.eyebrow}</p>
    <h2 class="bz-title" id={`bz-title-${tone}`}>{copy.title}</h2>
    <dl class="bz-grid">
      {
        copy.cells.map((c) => (
          <div class="bz-cell">
            <dt>{c.k}</dt>
            <dd>{c.v}</dd>
          </div>
        ))
      }
    </dl>
    <div class="bz-actions">
      {copy.actions.map((a) => <a class={`bz-btn bz-btn--${a.kind}`} href={a.href}>{a.label}</a>)}
    </div>
  </div>
</section>

<style>
  .bz-wrap { padding: 0 24px; margin: 8px auto 40px; max-width: 1280px; position: relative; z-index: 2; }
  .bz-archive { padding: 0 24px 24px; margin: 0 auto; }
  @media (min-width: 768px) { .bz-archive { padding: 0 48px 32px; } }
  .bz {
    padding: 28px 30px 26px;
    border: 1px solid rgba(200, 208, 224, 0.16);
    border-radius: 16px;
    background: rgba(26, 26, 62, 0.42);
    backdrop-filter: blur(10px);
    color: #c8d0e0;
  }
  .bz-eyebrow { margin: 0 0 8px; font: 500 0.7rem "IBM Plex Mono", ui-monospace, monospace; letter-spacing: 0.2em; text-transform: uppercase; color: #c9a962; }
  .bz-title { margin: 0 0 20px; font-weight: 600; font-size: clamp(1.25rem, 2.4vw, 1.75rem); line-height: 1.35; color: #e8ecf4; font-family: "Playfair Display", "Noto Serif JP", "Noto Serif SC", serif; }
  .bz-archive .bz-title { font-weight: 300; }
  .bz-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 0; }
  .bz-cell { border-top: 1px solid rgba(201, 169, 98, 0.45); padding-top: 10px; }
  .bz-cell dt { margin: 0 0 6px; font: 500 0.68rem "IBM Plex Mono", ui-monospace, monospace; letter-spacing: 0.12em; text-transform: uppercase; color: #8fa0c8; }
  .bz-cell dd { margin: 0; font-size: 0.88rem; line-height: 1.7; color: #c8d0e0; }
  .bz-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .bz-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; border-radius: 10px; font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: border-color 0.3s, transform 0.3s; }
  .bz-btn--primary { background: linear-gradient(90deg, #c9a962, #a88b4a); color: #0a0a0f; }
  .bz-btn--secondary { border: 1px solid rgba(200, 208, 224, 0.32); color: #e8ecf4; }
  .bz-btn:hover { transform: translateY(-1px); }
  .bz-btn--secondary:hover { border-color: rgba(201, 169, 98, 0.7); }
  @media (max-width: 1000px) { .bz-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .bz { padding: 22px 18px; } .bz-grid { grid-template-columns: 1fr; } .bz-wrap { padding: 0 16px; } }
</style>
